{
  "name": "my-job-finder",
  "version": "0.1.2",
  "description": "A local-first desktop job finder that ranks roles and prepares tailored PDF application documents.",
  "license": "MIT",
  "author": "Shudufhadzo Nemulalate and My Job Finder contributors",
  "type": "module",
  "homepage": "https://github.com/Shudufhadzo/my-job-finder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shudufhadzo/my-job-finder.git"
  },
  "bugs": {
    "url": "https://github.com/Shudufhadzo/my-job-finder/issues"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test src/desktop/*.test.ts src/discovery.test.ts src/platforms.test.ts",
    "desktop:state": "tsx src/desktop/cli.ts state",
    "desktop:configure": "tsx src/desktop/cli.ts configure",
    "desktop:refresh": "tsx src/desktop/cli.ts refresh",
    "desktop:build-worker": "tsc",
    "desktop:windows:build": "npm run desktop:build-worker && dotnet build apps/windows/MyJobFinder/MyJobFinder.csproj -p:Platform=x64",
    "desktop:windows:run": "npm run desktop:build-worker && dotnet run --project apps/windows/MyJobFinder/MyJobFinder.csproj -p:Platform=x64",
    "release:windows": "powershell -ExecutionPolicy Bypass -File apps/windows/build-release.ps1",
    "installer:windows": "powershell -ExecutionPolicy Bypass -File apps/windows/build-installer.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "csv-parse": "^6.2.1",
    "csv-stringify": "^6.7.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "playwright": "^1.59.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
