<Window
    x:Class="MyJobFinder.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MyJobFinder.Core"
    SizeChanged="MainWindow_SizeChanged">
    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Padding="28,0,150,0" Background="{StaticResource TitleBarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleSidebarColumn" Width="226" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="11" Background="{StaticResource ForestBrush}">
                    <FontIcon Glyph="&#xE821;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="My Job Finder" FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="PRIVATE WORKSPACE" FontSize="8" CharacterSpacing="115" Foreground="{StaticResource ForestBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="TitleStatusText" Grid.Column="2" Text="Local-first · Private" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel x:Name="TitleWorkspaceLabel" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="7" Height="7" CornerRadius="999" Background="#5F9F76" />
                <StackPanel Spacing="0">
                    <TextBlock Text="Daily job intelligence" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Match, prepare, track" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </StackPanel>
            <Border x:Name="TitleStatusPill" Grid.Column="2" Padding="11,6" CornerRadius="999" Background="#EAF0E6" BorderBrush="#C5D6CB" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE72E;" FontSize="11" Foreground="{StaticResource ForestBrush}" />
                    <TextBlock x:Name="TitleStatusPillText" Text="Local-first and private" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.ColumnSpan="3" Height="2" VerticalAlignment="Bottom" Background="{StaticResource TitleAccentBrush}" Opacity="0.72" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SidebarPanel" Grid.Column="0" Margin="12,10,0,12" Padding="16" CornerRadius="22" Background="#D6FFFFFF" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="WorkspaceLabel" Text="WORKSPACE" FontSize="10" CharacterSpacing="120" Foreground="{StaticResource MutedBrush}" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Stretch" Style="{StaticResource QuietButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE80F;" FontSize="14" />
                                <TextBlock x:Name="OpportunitiesLabel" Text="Opportunities" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,4,0,0" HorizontalAlignment="Stretch" Style="{StaticResource QuietButtonStyle}" Click="OpenDocuments_Click">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock x:Name="DocumentsLabel" Text="Documents" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <Border Padding="12" CornerRadius="14" Background="#EEF5F1">
                            <StackPanel Spacing="3">
                                <TextBlock Text="AUTOMATION" FontSize="9" CharacterSpacing="110" Foreground="{StaticResource ForestBrush}" />
                                <TextBlock x:Name="SidebarScheduleText" Text="Not configured" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PrivacyText" Text="Your CV stays on this device. Analysis reuses your local Codex session." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" SizeChanged="ContentScroll_SizeChanged">
                <Grid HorizontalAlignment="Stretch">
                <Grid x:Name="MainContentGrid" Margin="34,26,34,40" MaxWidth="1180" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="HeaderGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Your next move" Style="{StaticResource DisplayTextStyle}" FontSize="40" />
                            <TextBlock x:Name="ProfileGreetingText" Text="Organised every morning." FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" FontSize="25" Foreground="{StaticResource ForestBrush}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,8,0,0" Text="Fresh roles, ranked fit, and job-specific documents in one private workspace." Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="RunNowButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Top" Click="RunNow_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE895;" FontSize="14" />
                                <TextBlock Text="Run search now" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Expander x:Name="SetupExpander" Grid.Row="1" Margin="0,24,0,0" Header="Profile and daily search" IsExpanded="True">
                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                            <Grid x:Name="SetupGrid" ColumnSpacing="16" RowSpacing="13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel x:Name="NameField" Spacing="6">
                                    <TextBlock Text="Your name" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="NameBox" PlaceholderText="Full name" />
                                </StackPanel>
                                <StackPanel x:Name="CvField" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Master CV" Foreground="{StaticResource MutedBrush}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CvPathBox" IsReadOnly="True" PlaceholderText="Choose PDF, DOCX, or TXT" />
                                        <Button Grid.Column="1" Style="{StaticResource QuietButtonStyle}" Content="Choose" Click="ChooseCv_Click" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel x:Name="RolesField" Grid.Row="1" Spacing="6">
                                    <TextBlock Text="Roles you want" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="RolesBox" PlaceholderText="Project Manager, Teacher, Programme Coordinator" />
                                </StackPanel>
                                <StackPanel x:Name="LocationsField" Grid.Row="1" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Preferred locations" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox x:Name="LocationsBox" PlaceholderText="Johannesburg, Pretoria, Remote" />
                                </StackPanel>
                                <StackPanel x:Name="ScheduleField" Grid.Row="2" Spacing="6">
                                    <TextBlock Text="Run every day at" Foreground="{StaticResource MutedBrush}" />
                                    <TimePicker x:Name="SchedulePicker" Time="10:00:00" ClockIdentifier="24HourClock" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ScheduleToggle" Grid.Row="2" Grid.Column="1" Header="Daily background search" IsOn="True" VerticalAlignment="Center" />
                                <StackPanel x:Name="ModelField" Grid.Row="3" Spacing="6">
                                    <TextBlock Text="AI model" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox x:Name="ModelComboBox" IsEditable="True" ItemsSource="{x:Bind ViewModel.ModelOptions, Mode=OneWay}" PlaceholderText="Select or enter a Codex model">
                                        <ComboBox.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE950;" FontSize="13" />
                                                <TextBlock Text="Local Codex model" />
                                            </StackPanel>
                                        </ComboBox.Header>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="ReasoningField" Grid.Row="3" Grid.Column="1" Spacing="6">
                                    <TextBlock Text="Reasoning effort" Foreground="{StaticResource MutedBrush}" />
                                    <ComboBox x:Name="ReasoningComboBox" ItemsSource="{x:Bind ViewModel.ReasoningOptions, Mode=OneWay}" PlaceholderText="Select reasoning effort">
                                        <ComboBox.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE945;" FontSize="13" />
                                                <TextBlock Text="Analysis depth" />
                                            </StackPanel>
                                        </ComboBox.Header>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel x:Name="SaveField" Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                    <TextBlock x:Name="SetupErrorText" Foreground="#B42318" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="SaveProfile_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74E;" FontSize="13" />
                                            <TextBlock Text="Save and schedule" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>

                    <Grid x:Name="MetricsGrid" Grid.Row="2" Margin="0,22,0,0" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="TrackedMetric" Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource MetricIconStyle}" Background="#EAF2FF"><FontIcon Glyph="&#xE9D2;" Foreground="#275A9B" FontSize="17" /></Border><StackPanel Grid.Column="1"><TextBlock Text="TRACKED" FontSize="10" CharacterSpacing="110" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="TotalText" Text="0" Style="{StaticResource DisplayTextStyle}" FontSize="31" /></StackPanel></Grid>
                        </Border>
                        <Border x:Name="StrongMetric" Grid.Column="1" Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource MetricIconStyle}" Background="#E9F3EE"><FontIcon Glyph="&#xE735;" Foreground="{StaticResource ForestBrush}" FontSize="17" /></Border><StackPanel Grid.Column="1"><TextBlock Text="STRONG MATCHES" FontSize="10" CharacterSpacing="75" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="StrongText" Text="0" Style="{StaticResource DisplayTextStyle}" FontSize="31" Foreground="{StaticResource ForestBrush}" /></StackPanel></Grid>
                        </Border>
                        <Border x:Name="DocumentsMetric" Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource MetricIconStyle}" Background="#FFF4DE"><FontIcon Glyph="&#xE8A5;" Foreground="#9A5A00" FontSize="17" /></Border><StackPanel Grid.Column="1"><TextBlock Text="DOCUMENT SETS" FontSize="10" CharacterSpacing="75" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" /><TextBlock x:Name="DocumentsText" Text="0" Style="{StaticResource DisplayTextStyle}" FontSize="31" /></StackPanel></Grid>
                        </Border>
                        <Border x:Name="AppliedMetric" Grid.Column="3" Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource MetricIconStyle}" Background="#F4EDF8"><FontIcon Glyph="&#xE73E;" Foreground="#765080" FontSize="17" /></Border><StackPanel Grid.Column="1"><TextBlock Text="APPLIED" FontSize="10" CharacterSpacing="110" Foreground="{StaticResource MutedBrush}" /><TextBlock x:Name="AppliedText" Text="0" Style="{StaticResource DisplayTextStyle}" FontSize="31" /></StackPanel></Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="InsightsGrid" Grid.Row="3" Margin="0,16,0,0" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="PipelineCard" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="13">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE9D5;" Foreground="{StaticResource ForestBrush}" FontSize="17" />
                                    <TextBlock Text="Pipeline health" FontWeight="SemiBold" FontSize="16" />
                                </StackPanel>
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="Strong matches" Foreground="{StaticResource MutedBrush}" /><ProgressBar x:Name="StrongProgress" Grid.Column="1" Height="8" Maximum="100" VerticalAlignment="Center" Foreground="{StaticResource ForestBrush}" /><TextBlock x:Name="StrongRateText" Grid.Column="2" Text="0%" HorizontalAlignment="Right" /></Grid>
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="Documents ready" Foreground="{StaticResource MutedBrush}" /><ProgressBar x:Name="DocumentProgress" Grid.Column="1" Height="8" Maximum="100" VerticalAlignment="Center" Foreground="#C78624" /><TextBlock x:Name="DocumentRateText" Grid.Column="2" Text="0%" HorizontalAlignment="Right" /></Grid>
                                <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="Applied" Foreground="{StaticResource MutedBrush}" /><ProgressBar x:Name="AppliedProgress" Grid.Column="1" Height="8" Maximum="100" VerticalAlignment="Center" Foreground="#765080" /><TextBlock x:Name="AppliedRateText" Grid.Column="2" Text="0%" HorizontalAlignment="Right" /></Grid>
                            </StackPanel>
                        </Border>
                        <Border x:Name="OpportunityMixCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="11">
                                <StackPanel Orientation="Horizontal" Spacing="9">
                                    <FontIcon Glyph="&#xE9D9;" Foreground="#275A9B" FontSize="17" />
                                    <TextBlock Text="Opportunity mix" FontWeight="SemiBold" FontSize="16" />
                                </StackPanel>
                                <TextBlock x:Name="NoFieldsText" Text="Role categories appear after the first search." Foreground="{StaticResource MutedBrush}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.TopFields, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="core:FieldMetric">
                                            <Grid Margin="0,4" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="{x:Bind IconGlyph}" Foreground="{StaticResource ForestBrush}" FontSize="14" /><TextBlock Grid.Column="1" Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" /><Border Grid.Column="2" Padding="8,2" CornerRadius="999" Background="#EEF5F1"><TextBlock Text="{x:Bind Count}" Foreground="{StaticResource ForestBrush}" FontWeight="SemiBold" FontSize="11" /></Border></Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" Margin="0,18,0,0" Style="{StaticResource CardStyle}" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="SearchColumn" Width="320" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing x:Name="RunProgress" Width="22" Height="22" IsActive="False" />
                            <TextBlock x:Name="RunStatusText" Grid.Column="1" Margin="10,0" Text="Ready" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Filter roles, companies, locations" TextChanged="SearchBox_TextChanged" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="5" Margin="0,24,0,0" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <FontIcon Glyph="&#xE8F1;" Foreground="{StaticResource ForestBrush}" FontSize="20" />
                            <TextBlock Text="Opportunities" Style="{StaticResource DisplayTextStyle}" FontSize="24" />
                        </StackPanel>
                        <ListView x:Name="JobsList" ItemsSource="{x:Bind ViewModel.Jobs, Mode=OneWay}" ItemContainerStyle="{StaticResource JobListItemStyle}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="core:JobItem">
                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid RowSpacing="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Padding="8,3" CornerRadius="999" Background="#E9F3EE"><TextBlock Text="{x:Bind ScoreLabel}" Foreground="{StaticResource ForestBrush}" FontWeight="SemiBold" FontSize="11" /></Border>
                                                    <TextBlock Text="{x:Bind Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource DisplayTextStyle}" FontSize="20" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{StaticResource MutedBrush}"><Run Text="{x:Bind Company}" /><Run Text="  ·  " /><Run Text="{x:Bind Location}" /></TextBlock>
                                                <TextBlock Text="{x:Bind FieldLabel}" Foreground="{StaticResource ForestBrush}" FontSize="10" CharacterSpacing="60" />
                                                <TextBlock Text="{x:Bind Excerpt}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                            <Grid Grid.Row="1" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button HorizontalAlignment="Stretch" Style="{StaticResource QuietButtonStyle}" Tag="{x:Bind Url}" Click="OpenUrl_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7"><FontIcon Glyph="&#xE8A7;" FontSize="13" /><TextBlock Text="Open job" /></StackPanel></Button>
                                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource QuietButtonStyle}" Tag="{x:Bind SelectedCvPdf}" IsEnabled="{x:Bind HasCv}" Click="OpenFile_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7"><FontIcon Glyph="&#xE8A5;" FontSize="13" /><TextBlock Text="Open CV" /></StackPanel></Button>
                                                <Button Grid.Column="2" HorizontalAlignment="Stretch" Style="{StaticResource QuietButtonStyle}" Tag="{x:Bind SelectedCoverLetterPdf}" IsEnabled="{x:Bind HasCoverLetter}" Click="OpenFile_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7"><FontIcon Glyph="&#xE715;" FontSize="13" /><TextBlock Text="Cover letter" /></StackPanel></Button>
                                                <Button Grid.Column="3" HorizontalAlignment="Stretch" Style="{StaticResource QuietButtonStyle}" Tag="{x:Bind SelectedCvPdf}" IsEnabled="{x:Bind HasCv}" Click="RevealFile_Click"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7"><FontIcon Glyph="&#xE8B7;" FontSize="13" /><TextBlock Text="Show folder" /></StackPanel></Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
