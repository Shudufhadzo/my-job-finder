<Application
    x:Class="MyJobFinder.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="InkColor">#16221E</Color>
            <Color x:Key="MutedColor">#66736E</Color>
            <Color x:Key="ForestColor">#176A57</Color>
            <Color x:Key="LimeColor">#B8D96A</Color>
            <Color x:Key="StrokeColor">#D9E2DE</Color>
            <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="ForestBrush" Color="{StaticResource ForestColor}" />
            <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
            <SolidColorBrush x:Key="SkyBrush" Color="#1E6F9F" />
            <SolidColorBrush x:Key="AmberBrush" Color="#B86B25" />
            <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F1F7F3" Offset="0" />
                <GradientStop Color="#FBFCF8" Offset="0.5" />
                <GradientStop Color="#EDF4F1" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TitleBarBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F2F8F5" Offset="0" />
                <GradientStop Color="#F7FAF5" Offset="0.42" />
                <GradientStop Color="#F1F6FA" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TitleAccentBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#176A57" Offset="0" />
                <GradientStop Color="#80B77A" Offset="0.52" />
                <GradientStop Color="#4D88AE" Offset="1" />
            </LinearGradientBrush>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="#ECFFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="18" />
            </Style>
            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Background" Value="#F7FFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,9" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="{StaticResource ForestBrush}" />
            </Style>
            <Style x:Key="JobListItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            </Style>
            <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-15" />
            </Style>
            <Style x:Key="MetricIconStyle" TargetType="Border">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="Background" Value="#EAF3EF" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
